generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EDITOR
  SEO
}

enum PageStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(EDITOR)
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Phase 2: block-based page builder. Blocks are validated JSON, never raw HTML.
model Page {
  id                String         @id @default(cuid())
  // "page" | "article" | "project" | "service" — decides the public URL prefix
  kind              String         @default("page")
  category          String?
  translationId     String?
  title             String
  slug              String
  template          String         @default("landing")
  status            PageStatus     @default(DRAFT)
  blocks            Json           @default("[]")
  lang              String         @default("fr")
  authorId          String?
  // SEO
  primaryKeyword    String?
  secondaryKeywords String[]       @default([])
  seoTitle          String?
  metaDescription   String?
  canonicalUrl      String?
  noindex           Boolean        @default(false)
  nofollow          Boolean        @default(false)
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  breadcrumbLabel   String?
  schemaType        String         @default("WebPage")
  navVisible        Boolean        @default(false)
  publishedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  revisions         PageRevision[]

  @@unique([kind, lang, slug])
  @@index([status, publishedAt])
}

// Cookie-free, first-party aggregate analytics: no IP, no user id, only path + referrer host per day.
model PageView {
  id       String   @id @default(cuid())
  day      DateTime @db.Date
  path     String
  referrer String   @default("")
  count    Int      @default(1)

  @@unique([day, path, referrer])
  @@index([day])
}

model PageRevision {
  id        String   @id @default(cuid())
  note      String?
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  snapshot  Json
  createdAt DateTime @default(now())

  @@index([pageId])
}

model Redirect {
  id        String   @id @default(cuid())
  fromPath  String   @unique
  toPath    String
  permanent Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  service   String?
  message   String
  source    String?
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
}

// Reusable section library: a saved block that can be inserted (as a copy) into any page.
model SavedSection {
  id        String   @id @default(cuid())
  name      String
  type      String
  data      Json
  style     Json
  createdBy String?
  createdAt DateTime @default(now())
}
